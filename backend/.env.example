# ===============================================
# ForenSight Backend Environment Configuration Template
# ===============================================
# Copy this file to .env and fill in your actual values
# ===============================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# API Configuration
API_VERSION=v1
API_BASE_URL=/api

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name
MONGODB_DB_NAME=forensight
MONGODB_CONNECT_TIMEOUT=30000
MONGODB_SERVER_SELECTION_TIMEOUT=30000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# File Upload Configuration
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads
ALLOWED_FILE_TYPES=.db,.sqlite,.xml,.zip,.rar,.7z,.txt,.log,.json,.img,.dd
MAX_FILES_PER_UPLOAD=10

# Security Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Session Configuration
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000

# Case Management Configuration
DEFAULT_USER_ID=default
CASE_ID_PREFIX=FS
CASE_ID_LENGTH=8

# Evidence Processing Configuration
EVIDENCE_PROCESSING_TIMEOUT=300000
MAX_EVIDENCE_SIZE=524288000
AUTO_PROCESS_FILES=true

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/forensight.log
ENABLE_REQUEST_LOGGING=true

# Performance Configuration
REQUEST_TIMEOUT=120000
CONNECTION_POOL_SIZE=10
ENABLE_COMPRESSION=true

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_NETWORK_ANALYSIS=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_FILE_VALIDATION=true

# External Services Configuration
# Add your external service configurations here
# EXTERNAL_API_KEY=your_api_key_here
# EXTERNAL_SERVICE_URL=https://api.example.com

# Development Configuration
DEBUG_MODE=true
ENABLE_SWAGGER=true
ENABLE_MORGAN_LOGGING=true

# ===============================================
# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual configuration
# 3. Never commit .env files with real credentials to version control
# 4. Use strong, unique passwords and secrets
# ===============================================