                backgroundColor: '#dc2626',
                borderRadius: '12px',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                fontSize: '20px'
              }}>
                👤
              </div>
              <div style={{
                backgroundColor: statistics.totalSuspects > 0 ? '#dc2626' : '#64748b',
                color: 'white',
